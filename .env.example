# =============================================================================
# Reyna de Real Estate — Variables de entorno
#
# Copiá este archivo como `.env` y completá los valores reales.
# `.env` NO se versiona nunca. Este archivo sí, y va SIEMPRE sin valores reales.
#
# Nivel 1 (este archivo)  → desarrollo local
# Nivel 2 (panel Netlify) → producción, las mismas variables + el webhook
# Nivel 3 (panel admin)   → sin uso en esta entrega
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Postgres estándar. Sin extensiones propietarias, para poder mudarse (RNF-07).
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/reyna

# --- Autenticación -----------------------------------------------------------
# Mínimo 32 caracteres aleatorios. Generalo con:  openssl rand -base64 48
# Si esta clave se filtra, cualquiera puede firmar sesiones de administrador.
JWT_SECRET=

# --- Almacenamiento de imágenes (S3-compatible) ------------------------------
# En desarrollo apunta a MinIO; en producción, a Supabase Storage.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=reyna-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
# URL pública desde donde se sirven las imágenes. Si se omite, se arma con
# el endpoint y el bucket. Se separa para poder poner un CDN delante sin
# tocar código ni migrar las rutas guardadas en la base.
STORAGE_PUBLIC_URL=

# --- Envío de correo ---------------------------------------------------------
# Aviso de consultas nuevas. Si falla, el lead igual queda guardado (D-08).
RESEND_API_KEY=
# Remitente verificado en Resend
MAIL_FROM=web@reynaderealestate.com

# --- Sitio -------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:4321

# --- Publicación (solo Nivel 2, en Netlify) ----------------------------------
# Webhook que regenera el sitio cuando la administradora publica cambios.
# No se completa en desarrollo.
NETLIFY_BUILD_HOOK_URL=
