{
  "name": "reyna-de-real-estate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,astro,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,astro,css,md,json}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env backend/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:crear-admin": "tsx --env-file=.env backend/db/crear-admin.ts",
    "seed": "tsx --env-file=.env backend/db/seed/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.3",
    "@astrojs/react": "^6.0.4",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource/montserrat": "^5.2.5",
    "@fontsource/playfair-display": "^5.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.5",
    "@eslint/js": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
