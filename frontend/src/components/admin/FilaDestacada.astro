---
import { prepararMiniatura } from '../../lib/datos';
import type { Destacable } from '../../../../backend/lib/destacadas';

/**
 * Una propiedad en la pantalla de destacadas.
 *
 * **Las dos columnas usan esta misma fila.** No es ahorro de código: es que
 * mover una propiedad de "publicadas" a "en la portada" tiene que ser mover
 * un nodo de una lista a la otra. Si cada columna tuviera su propio marcado,
 * el navegador tendría que reconstruir la fila entera —miniatura, enlace,
 * botones— y ese es justo el código donde después aparecen las diferencias
 * entre lo que se ve y lo que se guarda.
 *
 * Qué botones se ven lo decide la lista que la contiene, por CSS.
 */
interface Props {
  p: Destacable;
  /** Posición en el carrusel, empezando en 1. Nulo si está fuera. */
  posicion?: number | null | undefined;
  primera?: boolean | undefined;
  ultima?: boolean | undefined;
}
const { p, posicion = null, primera = false, ultima = false } = Astro.props;

const mini = prepararMiniatura(p.portada, null, '');
const ubicacion = [p.ciudad, p.zona].filter(Boolean).join(' · ') || 'Sin ubicación';
const precio =
  p.precioAConsultar || !p.precioUsd
    ? 'A consultar'
    : `USD ${Number(p.precioUsd).toLocaleString('es-AR')}`;

const chico =
  'rounded border border-black/10 px-2 py-1 text-xs text-texto-suave hover:border-verde hover:text-verde disabled:cursor-not-allowed disabled:opacity-30';
---

<li
  data-fila
  data-id={p.id}
  draggable="true"
  class="flex items-center gap-3 rounded-[var(--radius-campo)] border border-black/10 bg-white p-3"
>
  {/* Oculto hasta que haya JavaScript: sin él no hay nada que arrastrar. */}
  <span data-agarre aria-hidden="true" class="hidden cursor-grab select-none px-1 text-texto-suave">
    ⋮⋮
  </span>

  <span data-posicion class="w-6 shrink-0 text-center text-xs font-semibold text-texto-suave">
    {posicion ?? ''}
  </span>

  {
    mini ? (
      <img
        src={mini.src}
        alt=""
        width="80"
        height="56"
        loading="lazy"
        class="h-14 w-20 shrink-0 rounded object-cover"
      />
    ) : (
      <span class="h-14 w-20 shrink-0 rounded bg-[#f2ece9]" />
    )
  }

  <span class="min-w-0 flex-1">
    <a
      href={`/admin/propiedades/${p.id}`}
      class="block truncate font-semibold text-texto hover:text-verde"
    >
      {p.titulo}
    </a>
    <span class="mt-0.5 block truncate text-xs text-texto-suave">
      {ubicacion} · {precio}
    </span>
  </span>

  <span data-botones-portada class="flex shrink-0 items-center gap-1">
    <button
      type="submit"
      name="mover"
      value={`subir:${p.id}`}
      data-subir
      disabled={primera}
      aria-label={`Subir ${p.titulo}`}
      class={chico}
    >
      ↑
    </button>
    <button
      type="submit"
      name="mover"
      value={`bajar:${p.id}`}
      data-bajar
      disabled={ultima}
      aria-label={`Bajar ${p.titulo}`}
      class={chico}
    >
      ↓
    </button>
    <button
      type="submit"
      name="mover"
      value={`quitar:${p.id}`}
      data-quitar
      aria-label={`Quitar ${p.titulo} de la portada`}
      class="ml-1 rounded border border-black/10 px-2 py-1 text-xs text-texto-suave hover:border-red-600 hover:text-red-700"
    >
      Quitar
    </button>
  </span>

  <button
    type="submit"
    name="mover"
    value={`agregar:${p.id}`}
    data-agregar
    aria-label={`Agregar ${p.titulo} a la portada`}
    class="shrink-0 rounded-full border border-verde px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.08em] text-verde transition-colors hover:bg-verde hover:text-white"
  >
    Agregar
  </button>
</li>
