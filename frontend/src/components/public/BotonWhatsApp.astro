---
import { type Configuracion } from '../../lib/datos';
import { enlaceWhatsApp } from '../../lib/whatsapp';
import { t } from '../../i18n';

/**
 * Botón flotante de WhatsApp. Es el canal principal de la clienta.
 *
 * Lleva un mensaje escrito de antemano para que el visitante no tenga que
 * pensar qué decir — eso solo hace que muchos no escriban.
 */
interface Props {
  config: Configuracion;
  contexto?: string | undefined;
}
const { config, contexto } = Astro.props;

const href = enlaceWhatsApp(config, { propiedad: contexto });
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="fixed bottom-5 right-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_6px_20px_rgba(15,30,29,0.28)] transition-transform duration-[400ms] ease-[var(--ease-marca)] hover:scale-105 sm:bottom-7 sm:right-7"
      aria-label={t('whatsapp.flotante')}
    >
      <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.5 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3.2-.7a11.3 11.3 0 0 1-4.6-4c-.3-.5-1.1-1.6-1.1-3 0-1.5.7-2.2 1-2.5.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.2.5.1.6 0l1-1.1c.2-.3.4-.2.6-.1l2 1c.2.1.4.2.4.3.1.2.1.7-.1 1.3Z" />
      </svg>
    </a>
  )
}
