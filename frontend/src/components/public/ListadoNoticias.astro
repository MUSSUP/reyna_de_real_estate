---
import CardNoticia from './CardNoticia.astro';
import { prepararImagen } from '../../lib/datos';

/**
 * La grilla de noticias.
 *
 * Vive acá porque la dibujan dos páginas —la primera, que es `/noticias`, y
 * las siguientes, que son `/noticias/pagina/2` y así— y una grilla duplicada
 * en dos archivos es una grilla que se va a desincronizar.
 */
interface Props {
  noticias: Awaited<ReturnType<typeof import('../../lib/datos').obtenerNoticias>>;
  /**
   * Sólo en la primera pantalla vale pedirle al navegador que adelante las
   * imágenes de arriba: en la página 3 nadie llega sin haber desplazado.
   */
  primeraPagina?: boolean;
}
const { noticias, primeraPagina = false } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {
    noticias.map((n, i) => {
      const portada = prepararImagen(
        n.coverPath,
        n.coverWidth,
        n.coverHeight,
        n.coverAltEs ?? n.titleEs,
      );
      return (
        <CardNoticia
          slug={n.slug}
          titulo={n.titleEs}
          bajada={n.excerptEs}
          fecha={n.publishedAt}
          imagenSrc={portada?.src}
          imagenSrcset={portada?.srcset}
          imagenAlt={portada?.alt}
          imagenAncho={portada?.width}
          imagenAlto={portada?.height}
          prioridad={primeraPagina && i < 3}
        />
      );
    })
  }
</div>
