---
/** Círculo verde con glifo blanco. Instagram, Facebook, YouTube, WhatsApp, web y mail. */
interface Props {
  red: 'instagram' | 'facebook' | 'youtube' | 'whatsapp' | 'web' | 'mail';
  href: string;
  etiqueta: string;
}

const { red, href, etiqueta } = Astro.props;

const trazos: Record<Props['red'], string> = {
  instagram:
    'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm5 5.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Zm5.8-1.3a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z',
  facebook:
    'M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.25-1.5 1.5-1.5h1.7V4.6A21 21 0 0 0 14.4 4.5c-2.4 0-4.1 1.5-4.1 4.2v2.2H7.6V14h2.7v8h3.2Z',
  youtube:
    'M22.5 7.5a2.7 2.7 0 0 0-1.9-1.9C18.9 5.1 12 5.1 12 5.1s-6.9 0-8.6.5A2.7 2.7 0 0 0 1.5 7.5C1 9.2 1 12 1 12s0 2.8.5 4.5a2.7 2.7 0 0 0 1.9 1.9c1.7.5 8.6.5 8.6.5s6.9 0 8.6-.5a2.7 2.7 0 0 0 1.9-1.9c.5-1.7.5-4.5.5-4.5s0-2.8-.5-4.5ZM9.8 15.3V8.7l5.7 3.3-5.7 3.3Z',
  whatsapp:
    'M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.5 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3.2-.7a11.3 11.3 0 0 1-4.6-4c-.3-.5-1.1-1.6-1.1-3 0-1.5.7-2.2 1-2.5.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.2.5.1.6 0l1-1.1c.2-.3.4-.2.6-.1l2 1c.2.1.4.2.4.3.1.2.1.7-.1 1.3Z',
  web: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2c1.4 0 3 2.6 3.4 6.5H8.6C9 6.6 10.6 4 12 4ZM4.3 10.5h2.3c.2-2.3.8-4.3 1.7-5.6a8 8 0 0 0-4 5.6Zm0 3h2.3c.2 2.3.8 4.3 1.7 5.6a8 8 0 0 1-4-5.6Zm4.3 0h6.8C15 17.4 13.4 20 12 20s-3-2.6-3.4-6.5Zm8.8 0h2.3a8 8 0 0 1-4 5.6c.9-1.3 1.5-3.3 1.7-5.6Zm0-3c-.2-2.3-.8-4.3-1.7-5.6a8 8 0 0 1 4 5.6h-2.3Z',
  mail: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm.9 2 8.1 5.6L20.1 7H3.9Z',
};

// Los enlaces salientes se abren en pestaña nueva; mailto y tel, no.
const externo = href.startsWith('http');
---

<a
  href={href}
  aria-label={etiqueta}
  {...externo ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-verde text-white transition-colors duration-[400ms] ease-[var(--ease-marca)] hover:bg-rosa"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={trazos[red]}></path>
  </svg>
</a>
