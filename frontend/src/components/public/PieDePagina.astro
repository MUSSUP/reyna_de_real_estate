---
import Corona from './Corona.astro';
import IconoSocial from './IconoSocial.astro';
import { valor, type Configuracion } from '../../lib/datos';
import { enlaceWhatsApp, soloDigitos } from '../../lib/whatsapp';

/**
 * Pie del sitio. Replica `design/referencias/footer.png` con las correcciones
 * que pidió la clienta: los teléfonos reales en lugar de los marcadores, y
 * **Facebook agregado**, que faltaba entre los íconos.
 */
interface Props {
  config: Configuracion;
}
const { config } = Astro.props;

const email = valor(config, 'contacto.email', 'reynaderealestate@gmail.com');
const telMx = valor(config, 'contacto.phone_mx');
const telAr = valor(config, 'contacto.phone_ar');

const redes = [
  { red: 'web' as const, href: '/', etiqueta: 'Sitio web' },
  { red: 'instagram' as const, href: valor(config, 'redes.instagram'), etiqueta: 'Instagram' },
  { red: 'facebook' as const, href: valor(config, 'redes.facebook'), etiqueta: 'Facebook' },
  {
    red: 'whatsapp' as const,
    href: enlaceWhatsApp(config),
    etiqueta: 'WhatsApp',
  },
  { red: 'mail' as const, href: `mailto:${email}`, etiqueta: 'Enviar un correo' },
  { red: 'youtube' as const, href: valor(config, 'redes.youtube'), etiqueta: 'YouTube' },
].filter((r) => r.href !== '');

const anio = new Date().getFullYear();
---

<footer class="bg-crema">
  <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-12">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-start lg:justify-between">
      <!-- Contacto -->
      <ul class="order-2 flex flex-col gap-3 text-sm lg:order-1">
        {
          telMx && (
            <li class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-verde text-white"
                aria-hidden="true"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z" />
                </svg>
              </span>
              <a href={`tel:${soloDigitos(telMx)}`} class="hover:text-verde">
                {telMx}
              </a>
            </li>
          )
        }
        {
          telAr && (
            <li class="flex items-center gap-3">
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-verde text-white"
                aria-hidden="true"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.5 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3.2-.7a11.3 11.3 0 0 1-4.6-4c-.3-.5-1.1-1.6-1.1-3 0-1.5.7-2.2 1-2.5.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.2.5.1.6 0l1-1.1c.2-.3.4-.2.6-.1l2 1c.2.1.4.2.4.3.1.2.1.7-.1 1.3Z" />
                </svg>
              </span>
              <a
                href={enlaceWhatsApp(config, { numero: telAr })}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-verde"
              >
                {telAr}
                <span class="sr-only">(WhatsApp, se abre en una pestaña nueva)</span>
              </a>
            </li>
          )
        }
        <li class="flex items-center gap-3">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-verde text-white"
            aria-hidden="true"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"
              ><path
                d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm.9 2 8.1 5.6L20.1 7H3.9Z"
              ></path></svg
            >
          </span>
          <a href={`mailto:${email}`} class="break-all hover:text-verde">{email}</a>
        </li>
      </ul>

      <!-- Marca -->
      <div class="order-1 text-center lg:order-2">
        <Corona tamano={46} clase="mx-auto text-rosa" />
        <p class="mt-3 font-titulo text-2xl tracking-wide text-verde sm:text-[28px]">
          REYNA DE REAL ESTATE
        </p>
        <div class="mt-3 flex items-center justify-center gap-2" aria-hidden="true">
          <span class="h-px w-16 bg-dorado/60"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-rosa"></span>
          <span class="h-px w-16 bg-dorado/60"></span>
        </div>
      </div>

      <!-- Redes -->
      <ul class="order-3 flex flex-wrap items-center justify-center gap-2.5">
        {
          redes.map((r) => (
            <li>
              <IconoSocial red={r.red} href={r.href} etiqueta={r.etiqueta} />
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-12 text-center text-sm text-texto-suave">
      © {anio} Reyna de Real Estate — Todos los derechos reservados
    </p>
  </div>
</footer>
