---
/**
 * Barra fija. Empieza transparente sobre el hero y se vuelve verde al bajar.
 *
 * El cambio se hace con animación ligada al scroll, en CSS. Donde el navegador
 * no la soporta queda **verde sólido desde el principio** — se ve algo distinto
 * al diseño pero siempre legible. El fallback nunca puede ser "transparente",
 * porque sobre contenido claro el logo blanco desaparecería.
 */
interface Props {
  sobreHero?: boolean;
}
const { sobreHero = false } = Astro.props;

const enlaces = [
  { href: '/propiedades', texto: 'Propiedades' },
  { href: '/noticias', texto: 'Noticias' },
];
---

<header
  class:list={[
    'fixed inset-x-0 top-0 z-50 transition-colors duration-[400ms] ease-[var(--ease-marca)]',
    sobreHero ? 'barra-sobre-hero' : 'bg-verde',
  ]}
>
  <nav
    class="mx-auto flex max-w-[1200px] items-center justify-between gap-4 px-5 py-3 sm:px-8 lg:px-12"
  >
    <a href="/" class="shrink-0" aria-label="Reyna de Real Estate — ir al inicio">
      <img
        src="/logos/logo-claro.webp"
        alt="Reyna de Real Estate"
        width="499"
        height="160"
        class="h-11 w-auto"
      />
    </a>

    <div class="flex items-center gap-1 sm:gap-4">
      {/* En pantalla ancha los enlaces van a la vista, como siempre. */}
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            class="hidden rounded-full px-3 py-2 font-cuerpo text-xs font-medium uppercase tracking-[0.12em] text-white/85 transition-colors hover:text-white sm:inline-block"
          >
            {e.texto}
          </a>
        ))
      }

      <a
        href="/#contacto"
        class="inline-flex min-h-[44px] items-center rounded-full bg-rosa px-5 py-2 font-cuerpo text-xs font-semibold uppercase tracking-[0.12em] text-white transition-colors duration-[400ms] ease-[var(--ease-marca)] hover:bg-rosa-hover"
      >
        Contacto
      </a>

      {
        /*
        El menú del celular.

        Hasta acá los enlaces estaban ocultos por debajo de 640 px: desde la
        ficha de una propiedad en un teléfono **no había forma de llegar al
        catálogo ni a las noticias**. Solo el logo, que lleva al inicio. Y los
        clientes de Laura entran casi todos desde el teléfono.

        Es un `<details>`, no un botón con script: es un desplegable de
        verdad, **funciona sin JavaScript**, y el navegador le da solo el
        comportamiento de teclado y el anuncio de abierto/cerrado. La política
        de seguridad del sitio además prohíbe los scripts incrustados.
      */
      }
      <details data-menu class="relative sm:hidden">
        <summary
          class="flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-full text-white transition-colors hover:bg-white/10"
          aria-label="Abrir el menú"
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>

        <nav
          aria-label="Secciones del sitio"
          class="absolute right-0 top-[calc(100%+0.5rem)] min-w-[11rem] rounded-[var(--radius-card)] bg-verde p-2 shadow-[0_18px_40px_rgba(0,0,0,0.3)] ring-1 ring-white/15"
        >
          {
            enlaces.map((e) => (
              <a
                href={e.href}
                class="flex min-h-[44px] items-center rounded-[var(--radius-campo)] px-4 font-cuerpo text-xs font-medium uppercase tracking-[0.12em] text-white/90 transition-colors hover:bg-white/10 hover:text-white"
              >
                {e.texto}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </nav>
</header>

<style>
  /* El `summary` trae un triángulo propio en cada motor. Se saca en los dos:
     `list-style` para Firefox y el pseudoelemento para Safari y Chrome. */
  [data-menu] > summary {
    list-style: none;
  }
  [data-menu] > summary::-webkit-details-marker,
  [data-menu] > summary::marker {
    display: none;
  }

  /* Sobre el hero arranca transparente y se vuelve verde al bajar 120px.
     El efecto se hace con una animación ligada al scroll, en CSS puro.

     **El estado por defecto es verde sólido, no transparente**, y eso es
     deliberado. Donde el navegador no soporta `animation-timeline`, la barra
     se queda como la deje el CSS base: si ese estado fuera transparente, el
     logo y el menú —que son blancos— desaparecerían sobre las secciones
     claras. Verde sólido se ve distinto al diseño, pero siempre se lee.

     Es el principio de D-14: cuando el efecto no corre, se ve el contenido
     sin efecto. Nunca al revés. */
  .barra-sobre-hero {
    background-color: var(--color-verde);
  }

  @supports (animation-timeline: scroll()) {
    .barra-sobre-hero {
      background-color: transparent;
      animation: pintar-barra linear both;
      animation-timeline: scroll();
      animation-range: 0 120px;
    }
  }

  @keyframes pintar-barra {
    from {
      background-color: transparent;
      box-shadow: none;
    }
    to {
      background-color: var(--color-verde);
      box-shadow: 0 4px 30px rgb(15 30 29 / 0.25);
    }
  }
</style>
