---
/**
 * Isotipo de la marca: la corona real de Laura Cabral, vectorizada del
 * original que entregó la clienta (`design/marca/iso-rosa.png`).
 *
 * Aparece como separador entre secciones y como remate de bloques.
 * Se pinta con `currentColor`, así que hereda el rosa de la paleta del sitio
 * en vez de arrastrar el degradé del archivo: un solo rosa en toda la página.
 *
 * Es decorativa: se oculta a los lectores de pantalla salvo que se le dé una
 * etiqueta explícita. Nombrarla como "corona" en cada aparición sería ruido
 * para quien navega escuchando.
 */
interface Props {
  tamano?: number;
  clase?: string | undefined;
  etiqueta?: string | undefined;
}

const { tamano = 24, clase = '', etiqueta } = Astro.props;
const decorativa = !etiqueta;
// La corona es apaisada; el alto sale de la proporción del original.
// Sin redondear: a 20px, un píxel de más la achata un 3%.
const alto = tamano * 0.6283;
---

<svg
  width={tamano}
  height={alto}
  viewBox="0 0 600 377"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  class={clase}
  role={decorativa ? 'presentation' : 'img'}
  aria-hidden={decorativa ? 'true' : undefined}
  aria-label={etiqueta}
