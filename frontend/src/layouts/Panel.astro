---
import '../styles/global.css';

/**
 * Armazón de todas las pantallas del panel: barra lateral y contenido.
 *
 * No comparte layout con el sitio público a propósito. El sitio es una pieza
 * editorial que se lee; el panel es una herramienta que se usa. Mezclarlos
 * termina en un panel bonito e incómodo.
 *
 * En móvil la barra lateral pasa a ser una fila de accesos arriba: la clienta
 * va a entrar desde el celular a mirar consultas más seguido que a cargar una
 * propiedad, y para eso no hace falta un menú desplegable.
 */
interface Props {
  titulo: string;
  /** Nombre de quien entró, para la barra superior. */
  usuario?: string | undefined;
  /** Ruta activa, para marcar el ítem del menú. */
  activo?: string | undefined;
}
const { titulo, usuario, activo = Astro.url.pathname } = Astro.props;

const SECCIONES = [
  { href: '/admin', texto: 'Tablero' },
  { href: '/admin/propiedades', texto: 'Propiedades' },
  { href: '/admin/destacadas', texto: 'Destacadas' },
  { href: '/admin/articulos', texto: 'Artículos' },
  { href: '/admin/catalogos', texto: 'Catálogos' },
  { href: '/admin/leads', texto: 'Consultas' },
  { href: '/admin/configuracion', texto: 'Configuración' },
];

const estaActivo = (href: string) =>
  href === '/admin' ? activo === '/admin' : activo.startsWith(href);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* El panel no se indexa: no es contenido público. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logos/favicon.png" />
    <title>{titulo} — Panel de Reyna de Real Estate</title>
  </head>

  <body class="min-h-screen bg-[#f4f1ee] font-cuerpo text-texto">
    <a
      href="#contenido-panel"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-verde focus:px-5 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>

    <div class="lg:flex">
      <aside class="bg-verde lg:min-h-screen lg:w-60 lg:shrink-0">
        <div class="flex items-center justify-between px-5 py-4 lg:block">
          <a href="/admin" class="inline-block">
            <img
              src="/logos/logo-claro.webp"
              alt="Reyna de Real Estate"
              width="499"
              height="160"
              class="h-9 w-auto"
            />
          </a>
          <a
            href="/"
            target="_blank"
            rel="noopener"
            class="text-xs text-white/70 underline-offset-4 hover:text-white hover:underline lg:mt-4 lg:block"
          >
            Ver el sitio ↗
          </a>
        </div>

        <nav aria-label="Secciones del panel" class="px-3 pb-4 lg:pt-2">
          <ul class="flex gap-1 overflow-x-auto lg:flex-col lg:overflow-visible">
            {
              SECCIONES.map((s) => (
                <li class="shrink-0">
                  <a
                    href={s.href}
                    aria-current={estaActivo(s.href) ? 'page' : undefined}
                    class:list={[
                      'block whitespace-nowrap rounded-lg px-3 py-2 text-sm transition-colors',
                      estaActivo(s.href)
                        ? 'bg-white/15 font-semibold text-white'
                        : 'text-white/75 hover:bg-white/10 hover:text-white',
                    ]}
                  >
                    {s.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header
          class="flex flex-wrap items-center justify-between gap-3 border-b border-black/5 bg-white px-5 py-3 sm:px-8"
        >
          <h1 class="font-titulo text-xl text-verde sm:text-2xl">{titulo}</h1>

          <div class="flex items-center gap-4 text-sm">
            {usuario && <span class="hidden text-texto-suave sm:inline">{usuario}</span>}
            <button
              type="button"
              data-cerrar-sesion
              class="rounded-full border border-verde/25 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.08em] text-verde transition-colors hover:bg-verde hover:text-white"
            >
              Salir
            </button>
          </div>
        </header>

        <main id="contenido-panel" class="min-w-0 flex-1 px-5 py-6 sm:px-8 sm:py-8">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline defer src="/js/panel.js"></script>
  </body>
</html>
