---
import '../../styles/global.css';

/**
 * "Olvidé mi contraseña": pedir el enlace.
 *
 * Pública: quien perdió la contraseña no puede tener sesión. Está exceptuada
 * en el middleware junto con el ingreso.
 *
 * **El aviso de éxito es siempre el mismo**, exista o no el correo. Decir "esa
 * dirección no está registrada" convertiría esta pantalla en una forma cómoda
 * de averiguar quién tiene acceso al panel.
 */
export const prerender = false;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logos/favicon.png" />
    <title>Recuperar la contraseña — Panel de Reyna de Real Estate</title>
  </head>

  <body class="flex min-h-screen items-center justify-center bg-verde px-5 py-10 font-cuerpo">
    <main class="w-full max-w-[400px]">
      <img
        src="/logos/logo-claro.webp"
        alt="Reyna de Real Estate"
        width="499"
        height="160"
        class="mx-auto h-12 w-auto"
      />

      <form
        data-formulario-recuperar
        class="mt-8 flex flex-col gap-5 rounded-[var(--radius-card)] bg-white p-7 sm:p-8"
      >
        <div>
          <h1 class="font-titulo text-xl text-verde">Recuperar la contraseña</h1>
          <p class="mt-2 text-sm text-texto-suave">
            Escribí tu correo y te mandamos un enlace para poner una nueva.
          </p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label
            for="rec-email"
            class="text-xs font-semibold uppercase tracking-[0.1em] text-texto-suave"
          >
            Email
          </label>
          <input
            id="rec-email"
            name="email"
            type="email"
            required
            autocomplete="username"
            autofocus
            class="w-full rounded-[var(--radius-campo)] border border-crema bg-white px-4 py-3 text-base text-texto transition-colors hover:border-dorado"
          />
        </div>

        <p
          data-aviso-recuperar
          role="alert"
          class="hidden rounded-[var(--radius-campo)] px-4 py-3 text-sm"
        >
        </p>

        <button
          type="submit"
          data-enviar
          disabled
          class="min-h-[48px] rounded-full bg-rosa px-6 py-3 font-cuerpo text-sm font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-rosa-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          Mandarme el enlace
        </button>

        <noscript>
          <p class="text-center text-sm text-texto-suave">
            El panel necesita JavaScript activado para funcionar.
          </p>
        </noscript>

        <a href="/admin/login" class="text-center text-sm text-verde underline hover:text-rosa">
          Volver al ingreso
        </a>
      </form>
    </main>

    <script is:inline defer src="/js/recuperar.js"></script>
  </body>
</html>
