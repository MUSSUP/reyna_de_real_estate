---
import '../../styles/global.css';

/**
 * Entrada al panel.
 *
 * El formulario se envía con JavaScript porque el endpoint responde JSON. Sin
 * script el navegador mostraría ese JSON en pantalla, así que **el botón queda
 * deshabilitado hasta que el script lo habilita**: es preferible un botón que
 * no se puede apretar y lo dice, a uno que parece funcionar y deja al usuario
 * frente a un volcado de datos.
 *
 * A diferencia del sitio público, acá no hay camino sin JavaScript que valga
 * la pena sostener: quien administra el sitio lo hace desde su computadora,
 * con un navegador normal, y no es la puerta de entrada de ningún cliente.
 */
export const prerender = false;

// Adónde volver después de entrar. Se acepta solo una ruta interna del panel:
// un destino de afuera convertiría el ingreso en un trampolín a otro sitio.
const pedido = Astro.url.searchParams.get('volver') ?? '';
const volver = /^\/admin(\/[\w\-/]*)?$/.test(pedido) ? pedido : '/admin';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/logos/favicon.png" />
    <title>Ingresar — Panel de Reyna de Real Estate</title>
  </head>

  <body class="flex min-h-screen items-center justify-center bg-verde px-5 py-10 font-cuerpo">
    <main class="w-full max-w-[400px]">
      <img
        src="/logos/logo-claro.webp"
        alt="Reyna de Real Estate"
        width="499"
        height="160"
        class="mx-auto h-12 w-auto"
      />

      <form
        data-formulario-ingreso
        data-volver={volver}
        class="mt-8 flex flex-col gap-5 rounded-[var(--radius-card)] bg-white p-7 sm:p-8"
      >
        <div class="flex flex-col gap-1.5">
          <label
            for="ingreso-email"
            class="text-xs font-semibold uppercase tracking-[0.1em] text-texto-suave"
          >
            Email
          </label>
          <input
            id="ingreso-email"
            name="email"
            type="email"
            required
            autocomplete="username"
            autofocus
            class="w-full rounded-[var(--radius-campo)] border border-crema bg-white px-4 py-3 text-base text-texto transition-colors hover:border-dorado"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label
            for="ingreso-clave"
            class="text-xs font-semibold uppercase tracking-[0.1em] text-texto-suave"
          >
            Contraseña
          </label>
          <input
            id="ingreso-clave"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full rounded-[var(--radius-campo)] border border-crema bg-white px-4 py-3 text-base text-texto transition-colors hover:border-dorado"
          />
        </div>

        {
          /* Un solo mensaje, idéntico ante cualquier falla: no se revela si el
            email existe. `role="alert"` hace que se anuncie al aparecer. */
        }
        <p
          data-aviso-ingreso
          role="alert"
          class="hidden rounded-[var(--radius-campo)] bg-red-50 px-4 py-3 text-sm text-red-800"
        >
        </p>

        <button
          type="submit"
          data-entrar
          disabled
          class="min-h-[48px] rounded-full bg-rosa px-6 py-3 font-cuerpo text-sm font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-rosa-hover disabled:cursor-not-allowed disabled:opacity-60"
        >
          Ingresar
        </button>

        <noscript>
          <p class="text-center text-sm text-texto-suave">
            El panel necesita JavaScript activado para funcionar.
          </p>
        </noscript>
      </form>
    </main>

    <script is:inline defer src="/js/ingreso.js"></script>
  </body>
</html>
