---
import Base from '../../layouts/Base.astro';
import BarraSuperior from '../../components/public/BarraSuperior.astro';
import PieDePagina from '../../components/public/PieDePagina.astro';
import BotonWhatsApp from '../../components/public/BotonWhatsApp.astro';
import { enlaceWhatsApp } from '../../lib/whatsapp';
import Galeria from '../../components/public/Galeria.astro';
import Badge from '../../components/public/Badge.astro';
import Boton from '../../components/public/Boton.astro';
import CardPropiedad from '../../components/public/CardPropiedad.astro';
import SeparadorCorona from '../../components/public/SeparadorCorona.astro';
import FormularioContacto from '../../components/public/FormularioContacto.astro';
import {
  obtenerConfiguracion,
  obtenerPropiedad,
  obtenerPublicadas,
  obtenerSimilares,
  valor,
} from '../../lib/datos';

/** Una página por propiedad publicada, generada al construir el sitio. */
export async function getStaticPaths() {
  const propiedades = await obtenerPublicadas();
  return propiedades.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const propiedad = await obtenerPropiedad(slug!);

if (!propiedad) {
  return Astro.redirect('/404');
}

const config = await obtenerConfiguracion();
const similares = await obtenerSimilares(propiedad);

const formatoPrecio = new Intl.NumberFormat('es-MX', { maximumFractionDigits: 0 });
const precio =
  propiedad.precioAConsultar || propiedad.precioUsd == null
    ? 'Precio a consultar'
    : `USD ${formatoPrecio.format(propiedad.precioUsd)}`;

const ETIQUETA_OBRA = { pozo: 'En pozo', construccion: 'En construcción', terminado: 'Terminado' };
const ETIQUETA_OPERACION = { venta: 'En venta', renta: 'En renta' };

/**
 * En terrenos se omiten dormitorios, baños y antigüedad: un lote sin construir
 * no los tiene, y mostrar "0 dormitorios" se lee como un error del sitio.
 */
const atributos = [
  propiedad.metrosCubiertos
    ? { etiqueta: 'Cubiertos', valor: `${propiedad.metrosCubiertos} m²` }
    : null,
  propiedad.metrosTotales ? { etiqueta: 'Totales', valor: `${propiedad.metrosTotales} m²` } : null,
  !propiedad.esTerreno ? { etiqueta: 'Dormitorios', valor: String(propiedad.dormitorios) } : null,
  !propiedad.esTerreno ? { etiqueta: 'Baños', valor: String(propiedad.banos) } : null,
  { etiqueta: 'Tipo', valor: propiedad.tipologia },
  { etiqueta: 'Operación', valor: ETIQUETA_OPERACION[propiedad.operacion] },
  { etiqueta: 'Estado', valor: ETIQUETA_OBRA[propiedad.estadoObra] },
  !propiedad.esTerreno && propiedad.anio
    ? { etiqueta: 'Antigüedad', valor: String(propiedad.anio) }
    : null,
].filter((a): a is { etiqueta: string; valor: string } => a !== null);

const enlaceWhatsapp = enlaceWhatsApp(config, { propiedad: propiedad.titulo });

const descripcionSocial =
  propiedad.descripcion?.slice(0, 155) ??
  `${propiedad.titulo} en ${propiedad.ubicacion}, ${propiedad.pais}. ${precio}.`;

/** Datos estructurados: ayudan a que los buscadores entiendan que es un inmueble. */
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: propiedad.titulo,
  description: propiedad.descripcion ?? undefined,
  url: new URL(`/propiedades/${propiedad.slug}`, Astro.site).toString(),
  image: propiedad.portada?.src,
  address: {
    '@type': 'PostalAddress',
    addressLocality: propiedad.ubicacion,
    addressCountry: propiedad.pais,
  },
  ...(propiedad.precioUsd != null && !propiedad.precioAConsultar
    ? { offers: { '@type': 'Offer', price: propiedad.precioUsd, priceCurrency: 'USD' } }
    : {}),
};
---

<Base
  titulo={`${propiedad.titulo} — ${propiedad.ubicacion} | Reyna de Real Estate`}
  descripcion={descripcionSocial}
  imagenSocial={propiedad.portada?.src}
>
  <BarraSuperior />

  <main class="bg-white pb-20 pt-24">
    <div class="mx-auto max-w-[1200px] px-5 sm:px-8 lg:px-12">
      <nav aria-label="Migas de pan" class="py-4 text-sm text-texto-suave">
        <a href="/propiedades" class="hover:text-verde">Propiedades</a>
        <span aria-hidden="true"> / </span>
        <span class="text-verde">{propiedad.titulo}</span>
      </nav>

      <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:items-start">
        <div>
          <Galeria imagenes={propiedad.galeria} titulo={propiedad.titulo} />
        </div>

        <div class="lg:sticky lg:top-24">
          <div class="flex flex-wrap gap-2">
            <Badge variante="pais">{propiedad.pais}</Badge>
            <Badge variante="ubicacion">{propiedad.ubicacion}</Badge>
            {
              propiedad.estadoObra !== 'terminado' && (
                <Badge variante="estado">{ETIQUETA_OBRA[propiedad.estadoObra]}</Badge>
              )
            }
          </div>

          <h1 class="mt-4 font-titulo text-3xl leading-tight text-verde sm:text-4xl">
            {propiedad.titulo}
          </h1>

          <p class="mt-3 font-cuerpo text-2xl font-medium text-verde-claro">{precio}</p>

          <dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-crema pt-6 text-sm">
            {
              atributos.map((a) => (
                <div>
                  <dt class="text-xs uppercase tracking-wider text-texto-suave">{a.etiqueta}</dt>
                  <dd class="mt-0.5 font-medium text-texto">{a.valor}</dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-8 flex flex-col gap-3">
            <Boton variante="primario" href="#contacto" anchoCompleto>Consultar</Boton>
            <a
              href={enlaceWhatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] w-full items-center justify-center gap-2 rounded-full bg-[#25D366] px-7 py-3 font-cuerpo text-xs font-semibold uppercase tracking-[0.12em] text-white transition-opacity hover:opacity-90"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.5 14.1c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-3.2-.7a11.3 11.3 0 0 1-4.6-4c-.3-.5-1.1-1.6-1.1-3 0-1.5.7-2.2 1-2.5.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.2.5.1.6 0l1-1.1c.2-.3.4-.2.6-.1l2 1c.2.1.4.2.4.3.1.2.1.7-.1 1.3Z"
                ></path>
              </svg>
              Escribir por WhatsApp
              <span class="sr-only">sobre {propiedad.titulo} (se abre en una pestaña nueva)</span>
            </a>
          </div>
        </div>
      </div>

      {
        propiedad.descripcion && (
          <section class="mt-14 max-w-[65ch]">
            <h2 class="font-titulo text-2xl text-verde">Sobre esta propiedad</h2>
            <p class="mt-4 whitespace-pre-line leading-relaxed">{propiedad.descripcion}</p>
          </section>
        )
      }

      {
        propiedad.comodidades.length > 0 && (
          <section class="mt-14">
            <h2 class="font-titulo text-2xl text-verde">Amenidades</h2>
            <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
              {propiedad.comodidades.map((c) => (
                <li class="flex items-center gap-2.5 rounded-[var(--radius-campo)] bg-crema px-4 py-3 text-sm">
                  <span class="text-dorado" aria-hidden="true">
                    ◆
                  </span>
                  {c.nombre}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        propiedad.driveUrl && (
          <section class="mt-14">
            <div class="flex flex-col items-start gap-4 rounded-[var(--radius-card)] bg-verde p-6 text-white sm:flex-row sm:items-center sm:justify-between sm:p-8">
              <div>
                <h2 class="font-titulo text-2xl">Más material</h2>
                <p class="mt-1 text-white/75">
                  El video y las fotos completas de {propiedad.titulo}.
                </p>
              </div>
              <a
                href={propiedad.driveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] shrink-0 items-center justify-center rounded-full bg-rosa px-7 py-3 font-cuerpo text-xs font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-rosa-hover"
              >
                Ver el video y más material
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            </div>
          </section>
        )
      }

      {
        /* El formulario ya llega con la propiedad puesta: quien consulta desde
          acá no tiene que explicar cuál le interesa. WhatsApp y correo quedan
          debajo, para quien prefiera escribir por su cuenta. */
      }
      <section
        id="contacto"
        class="mt-14 scroll-mt-24 rounded-[var(--radius-card)] bg-crema p-6 sm:p-10"
      >
        <div class="text-center">
          <h2 class="font-titulo text-2xl text-verde">¿Te interesa {propiedad.titulo}?</h2>
          <p class="mx-auto mt-3 max-w-[52ch] text-texto-suave">
            Escribinos y te contamos todo: disponibilidad, condiciones y cómo visitarla.
          </p>
        </div>

        <div class="mx-auto mt-8 max-w-[680px] rounded-[var(--radius-card)] bg-white p-5 sm:p-8">
          <FormularioContacto
            origen={`/propiedades/${propiedad.slug}`}
            propiedadSlug={propiedad.slug}
            propiedadTitulo={propiedad.titulo}
            interesInicial={propiedad.operacion === 'renta' ? 'rentar' : 'invertir'}
          />
        </div>

        <div class="mt-7 text-center text-sm text-texto-suave">
          <p>¿Preferís escribirnos directo?</p>
          <div class="mt-3 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-6">
            <a
              href={enlaceWhatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-verde underline-offset-4 hover:underline"
            >
              Escribir por WhatsApp
              <span class="sr-only">(se abre en una pestaña nueva)</span>
            </a>
            <a
              href={`mailto:${valor(config, 'contacto.email')}?subject=${encodeURIComponent(`Consulta por ${propiedad.titulo}`)}`}
              class="font-semibold text-verde underline-offset-4 hover:underline"
            >
              Enviar un correo
            </a>
          </div>
        </div>
      </section>

      {
        similares.length > 0 && (
          <section class="mt-20">
            <h2 class="text-center font-titulo text-2xl uppercase tracking-[0.08em] text-verde">
              Propiedades similares
            </h2>
            <SeparadorCorona clase="mt-4" />
            <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {similares.map((s) => (
                <CardPropiedad
                  slug={s.slug}
                  titulo={s.titulo}
                  pais={s.pais}
                  ubicacion={s.ubicacion}
                  precioUsd={s.precioUsd}
                  precioAConsultar={s.precioAConsultar}
                  metros={s.metrosTotales ?? s.metrosCubiertos}
                  dormitorios={s.dormitorios}
                  banos={s.banos}
                  esTerreno={s.esTerreno}
                  imagenSrc={s.portada?.src}
                  imagenSrcset={s.portada?.srcset}
                  imagenAlt={s.portada?.alt}
                  imagenAncho={s.portada?.width}
                  imagenAlto={s.portada?.height}
                />
              ))}
            </div>
          </section>
        )
      }
    </div>
  </main>

  <PieDePagina config={config} />
  <BotonWhatsApp config={config} contexto={propiedad.titulo} />

  <script is:inline defer src="/js/galeria.js"></script>
  <script is:inline defer src="/js/formulario.js"></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
</Base>
