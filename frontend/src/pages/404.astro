---
import Base from '../layouts/Base.astro';
import BarraSuperior from '../components/public/BarraSuperior.astro';
import PieDePagina from '../components/public/PieDePagina.astro';
import BotonWhatsApp from '../components/public/BotonWhatsApp.astro';
import Corona from '../components/public/Corona.astro';
import Boton from '../components/public/Boton.astro';
import { obtenerConfiguracion } from '../lib/datos';

const config = await obtenerConfiguracion();
---

<Base
  titulo="Página no encontrada — Reyna de Real Estate"
  descripcion="La página que buscás no existe."
  noIndexar={true}
>
  <BarraSuperior />

  <main class="flex min-h-[70vh] items-center justify-center px-6 pt-24">
    <div class="text-center">
      <Corona tamano={48} clase="mx-auto text-rosa" />
      <p class="texto-claim mt-6 text-xs text-texto-suave">Error 404</p>
      <h1 class="mt-3 font-titulo text-3xl text-verde sm:text-4xl">No encontramos esta página</h1>
      <p class="mx-auto mt-4 max-w-[46ch] text-texto-suave">
        Puede que el enlace haya cambiado o que la propiedad ya no esté publicada.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Boton variante="primario" href="/propiedades">Ver propiedades</Boton>
        <Boton variante="terciario" href="/">Volver al inicio</Boton>
      </div>
    </div>
  </main>

  <PieDePagina config={config} />
  <BotonWhatsApp config={config} />
</Base>
