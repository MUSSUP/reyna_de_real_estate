---
import Base from '../../layouts/Base.astro';
import BarraSuperior from '../../components/public/BarraSuperior.astro';
import PieDePagina from '../../components/public/PieDePagina.astro';
import BotonWhatsApp from '../../components/public/BotonWhatsApp.astro';
import Contenedor from '../../components/public/Contenedor.astro';
import SeparadorCorona from '../../components/public/SeparadorCorona.astro';
import ListadoNoticias from '../../components/public/ListadoNoticias.astro';
import Paginador from '../../components/public/Paginador.astro';
import Corona from '../../components/public/Corona.astro';
import Boton from '../../components/public/Boton.astro';
import { NOTICIAS_POR_PAGINA, obtenerConfiguracion, obtenerNoticias } from '../../lib/datos';
import { t } from '../../i18n';

/**
 * Listado de noticias.
 *
 * Existía en el menú desde UJ-01 y la página no estaba: el enlace llevaba a un
 * 404 desde las trece páginas del sitio. Lo encontró la revisión del Hito 1 y
 * por eso este journey se adelantó del Hito 3.
 *
 * Se genera al construir, como el resto del sitio público (D-04).
 *
 * Esta es la primera pantalla; de la segunda en adelante las dibuja
 * `pagina/[n].astro`. Es la dirección canónica del listado: no existe
 * `/noticias/pagina/1`, para no tener la misma lista en dos direcciones.
 *
 * El paginado lo pide UJ-15 por escrito. Con tres noticias no se nota, pero
 * la clienta puede escribir todas las que quiera desde el panel, y sin esto
 * cuarenta noticias eran cuarenta imágenes en una sola carga.
 */
const config = await obtenerConfiguracion();
const todas = await obtenerNoticias();
const paginas = Math.max(1, Math.ceil(todas.length / NOTICIAS_POR_PAGINA));
const noticias = todas.slice(0, NOTICIAS_POR_PAGINA);
---

<Base
  titulo="Noticias del mercado inmobiliario — Reyna de Real Estate"
  descripcion="Novedades y análisis del mercado de Riviera Maya: desarrollos, tendencias y qué mirar antes de invertir."
>
  <BarraSuperior />

  <main id="contenido" class="pt-24">
    <Contenedor>
      <header class="py-10 text-center sm:py-14">
        <p class="texto-claim text-xs text-texto-suave">Reyna de Real Estate</p>
        <h1 class="mt-3 font-titulo text-3xl text-verde sm:text-4xl">{t('noticias.titulo')}</h1>
        <SeparadorCorona clase="mt-4" />
        <p class="mx-auto mt-5 max-w-[56ch] text-texto-suave">{t('noticias.bajada')}</p>
      </header>

      {
        noticias.length > 0 ? (
          <div class="pb-20">
            <ListadoNoticias noticias={noticias} primeraPagina />
            <div class="mt-12">
              <Paginador pagina={1} total={paginas} base="/noticias" />
            </div>
          </div>
        ) : (
          // Sin noticias la página no queda en blanco: explica qué va a haber
          // acá y ofrece dos salidas.
          <div class="mx-auto max-w-[46ch] pb-24 text-center">
            <Corona tamano={44} clase="mx-auto text-rosa" />
            <p class="mt-6 font-titulo text-xl text-verde">{t('estados.sinNoticias')}</p>
            <p class="mt-3 text-texto-suave">
              Estamos preparando las primeras notas. Mientras tanto, mirá lo que hay disponible.
            </p>
            <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
              <Boton variante="primario" href="/propiedades">
                Ver propiedades
              </Boton>
              <Boton variante="terciario" href="/#contacto">
                Escribinos
              </Boton>
            </div>
          </div>
        )
      }
    </Contenedor>
  </main>

  <PieDePagina config={config} />
  <BotonWhatsApp config={config} />
</Base>
